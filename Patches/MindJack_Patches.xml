<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThingDef[not(@ParentName="Bow_Great")]/comps/li[@Class="CompProperties_UniqueWeapon"]</xpath>
    <value>
      <li>
          <compClass>MindJackUniqueWeaponBind.MJUWE_PortThingComp</compClass>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Gun_SniperRifle_Unique"]/weaponTags</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Gun_SniperRifle_Unique"]</xpath>
      <value>
        <weaponTags>
          <li>MJUWE_PortWeapon</li>
        </weaponTags>
      </value>
    </nomatch>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Gun_SniperRifle_Unique"]/weaponTags</xpath>
        <value>
          <li>MJUWE_PortWeapon</li>
        </value>
    </match>
  </Operation>

   <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Gun_SniperRifle_Unique"]/generateAllowChance</xpath>
    <value>
      <generateAllowChance>1</generateAllowChance>
    </value>
  </Operation> 

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Human"]/recipes</xpath>
    <value>
      <li>MJUWE_FormatMindJack</li>
    </value>
  </Operation>
</Patch>