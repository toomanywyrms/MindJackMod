<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <HediffDef>
      <defName ParentName="ImplantHediffBase">MJUWE_MindJackHediff</defName>
      <label>mindjack</label>
      <labelNoun>a mindjack</labelNoun>
      <hediffClass>MindJackMod.MJUWE_MindJack</hediffClass>
      <description>An installed mindjack, allowing the user to connect directly to a specialized weapon's Port, copying the unique markup of their brain and registering it with the onboard rudamentary AI. While the user is holding the reigistered weapon, their performance with the weapon is increased, and their state of mind is enhanced. Once installed, the user can not remove the mindjack, as it will result in irreperable damage to the brain, as well as potential death.\n\nThe user can format their mindjack to register it with a new weapon, however, their mental capacities will suffer while the format process runs.</description>
      <initialSeverity>0.01</initialSeverity>
      <isBad>false</isBad>
      <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
      <maxSeverity>4</maxSeverity>
      <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
      <comps>
        <li Class="HediffCompProperties_SeverityPerDay">
          <severityPerDay>-0.14</severityPerDay>
        </li>
      </comps> 
      <stages> 
        <li>
            <label>unregistered</label>
            <minSeverity>0.001</minSeverity>
        </li>
        <li>
            <label>formatting</label>
            <minSeverity>0.002</minSeverity>
            <capMods>
              <li>
                <capacity>Consciousness</capacity>
                <setMax>0.9</setMax>
              </li>      
            </capMods>
         </li>
         <li>
            <label>connected</label>
            <minSeverity>3</minSeverity>
            <capMods>
              <li>
                <capacity>Consciousness</capacity>
                <offset>0.1</offset>
              </li>      
            </capMods>
         </li>
         <li>
            <label>disconnected</label>
            <minSeverity>4</minSeverity>
         </li>   
      </stages>
    </HediffDef>

  <ThingDef ParentName="BodyPartProstheticMakeableBase">
      <defName>MJUWE_MindJack</defName>
      <label>mindjack</label>
      <description>An implant installed in the brain, allowing the user to connect directly to a specialized weapon's Port, copying the unique markup of their brain and registering it with the onboard rudamentary AI. While the user is holding the reigistered weapon, their performance with the weapon is increased, and their state of mind is enhanced. Once installed, the user can not remove the mindjack, as it will result in irreperable damage to the brain, as well as potential death.\n\nThe user can format their mindjack to register it with a new weapon, however, their mental capacities will suffer while the format process runs.</description>
      <descriptionHyperlinks><RecipeDef>MJUWE_InstallMindJack</RecipeDef></descriptionHyperlinks>
      <thingSetMakerTags><li>RewardStandardLowFreq</li></thingSetMakerTags>
      <graphicData>
        <texPath>MJUWE/MJUWEIMplant</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <color>(255,255,255)</color>
		</graphicData>
      <costList>
        <Steel>40</Steel>
        <ComponentIndustrial>6</ComponentIndustrial>
      </costList>
      <statBases>
        <Mass>0.1</Mass>
        <DeteriorationRate>0.2</DeteriorationRate>
        <MaxHitPoints>100</MaxHitPoints>
        <Flammability>0</Flammability>
        <MarketValue>700</MarketValue> 
      </statBases>
      <recipeMaker>
        <researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
      </recipeMaker>
      <techHediffsTags>
        <li>Advanced</li>
      </techHediffsTags>
    </ThingDef>

    <RecipeDef ParentName="SurgeryInstallImplantBase">
      <defName>MJUWE_InstallMindJack</defName>
      <label>install mindjack</label>
      <description>Install a mindjack</description>
      <descriptionHyperlinks>
        <ThingDef>MJUWE_MindJack</ThingDef>
        <HediffDef>MJUWE_MindJackHediff</HediffDef>
      </descriptionHyperlinks>
      <uiIconThing>MJUWE_MindJack</uiIconThing>
      <jobString>Installing mindjack.</jobString>
      <ingredients>
        <li>
          <filter>
            <thingDefs>
              <li>MJUWE_MindJack</li>
            </thingDefs>
          </filter>
          <count>1</count>
        </li>
      </ingredients>
      <fixedIngredientFilter>
        <thingDefs>
          <li>MJUWE_MindJack</li>
        </thingDefs>
      </fixedIngredientFilter>
      <appliedOnFixedBodyParts>
        <li>Brain</li>
      </appliedOnFixedBodyParts>
      <addsHediff>MJUWE_MindJackHediff</addsHediff>
    </RecipeDef>

    <RecipeDef ParentName="SurgeryFlesh">
      <defName>MJUWE_FormatMindJack</defName>
      <label>format Mindjack</label>
      <description>testing.</description>
      <workerClass>MindJackMod.MJUWE_SurgeryFormat</workerClass>
      <jobString>Formatting mindjack.</jobString>
      <effectWorking>Hacking</effectWorking>
		  <soundWorking>Hacking_InProgress</soundWorking>
      <workAmount>500</workAmount>
      <hideBodyPartNames>true</hideBodyPartNames>
      <targetsBodyPart>false</targetsBodyPart>
      <descriptionHyperlinks>
        <ThingDef>MJUWE_MindJack</ThingDef>
      </descriptionHyperlinks>
      <uiIconThing>MJUWE_MindJack</uiIconThing>
      <anesthetize>false</anesthetize>
    </RecipeDef>

    <JobDef>
      <defName>MJUWE_MindJackRegistration</defName>
      <driverClass>MindJackMod.MJUWE_RegisterJob</driverClass>
      <reportString>hacking TargetA.</reportString>
    </JobDef>

  </Defs>